import numpy as np 
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt

xData = np.array([2, 5, 7])
yData = np.array([15, 28, 40])

xData = xData.reshape(3,1)
ourmodel = LinearRegression()
ourmodel.fit (xData, yData)

alpha = ourmodel.intercept_
beta = ourmodel.coef_[0]

print(f'alpha={alpha:.2f}, beta={beta:.2f}')

plt.figure()
plt.scatter(xData.flatten(), yData, color='red', label='Relación entre inversión y ventas')

x_extremos=np.array([0,12]). reshape(-1,1)
y_predichos=ourmodel.predict(x_extremos)

X_nuevos = np.array([1, 10.0]).reshape(-1, 1)
Y_nuevos_predichos = ourmodel.predict(X_nuevos)

print(f"Ventas estimadas para 1 millón de inversión: {Y_nuevos_predichos[0]:.2f}")
print(f"Ventas estimadas para 10 millones de inversión: {Y_nuevos_predichos[1]:.2f}")

plt.scatter(X_nuevos.flatten(), Y_nuevos_predichos, color='blue', marker='*', s=80, label='Estimaciones para 1 y 10 millones')
plt.plot(x_extremos, y_predichos, color='blue', label= 'Recta de Regresión')
plt.xlabel('Variable x')
plt.ylabel('Variable y')
plt.title('Regresión Lineal')
plt.grid(True)
plt.legend()
plt.show()

B_start=  -5
B_end= 15
n_points= 1000
B_values= np.linspace(B_start, B_end, n_points)

def f_aux_B(B):
    return (15-alpha-B*2)**2 + (28-alpha-B*5)**2 + (40-alpha-B*7)**2

f_aux_B_values= f_aux_B(B_values)

sce = f_aux_B(beta)
print(f"Suma de Errores al Cuadrado (SCE): {sce:.2f}")

plt.figure()
plt.plot(B_values, f_aux_B_values, color='green', label='Suma de errores al cuadrado')
plt.title('Suma errores al cuadrado')
plt.xlabel('Valores de pendiente')
plt.ylabel('Suma de errores al cuadrado')
plt.grid(True)
plt.legend()
plt.show()  